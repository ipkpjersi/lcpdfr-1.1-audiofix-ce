+        /// <summary>
+        /// The single DirectSound device shared by every sound.
+        /// </summary>
+        /// <remarks>
+        /// Originally a new DirectSound was constructed for every sound played and never
+        /// disposed. Each one is a WASAPI endpoint under Wine and keeps a mixer thread
+        /// alive, and each thread reserves about 1 MB of address space. In a 32-bit
+        /// process that exhausts the address space after roughly 330 sounds, which was a
+        /// hard crash inside ntdll, and before that it exhausted PipeWire's descriptors.
+        /// One device for the whole process removes the leak at its source.
+        /// </remarks>
+        private static DirectSound sharedDevice;
+
+        /// <summary>
+        /// Guards creation of <see cref="sharedDevice"/>, which is reached from several
+        /// audio threads.
+        /// </summary>
+        private static readonly object sharedDeviceLock = new object();
+
+        /// <summary>
+        /// How long to wait for a buffer to start or finish before giving up.
+        /// </summary>
+        /// <remarks>
+        /// Both waits below were untimed. A buffer that never reaches Playing, which is
+        /// what happens when the audio device is unhealthy, wedged the calling thread for
+        /// the rest of the session. On a background thread that silently killed all audio,
+        /// because AudioHelper's busy flag was never reset; on the script thread it froze
+        /// the game.
+        /// </remarks>
+        private const int PlaybackWaitTimeoutMilliseconds = 5000;
+
+        /// <summary>
+        /// Returns the shared DirectSound device, creating it on first use.
+        /// </summary>
+        private static DirectSound GetSharedDevice()
+        {
+            lock (sharedDeviceLock)
+            {
+                if (sharedDevice == null)
+                {
+                    sharedDevice = new DirectSound();
+                    sharedDevice.SetCooperativeLevel(System.Diagnostics.Process.GetCurrentProcess().MainWindowHandle, CooperativeLevel.Priority);
+                }
+
+                return sharedDevice;
+            }
+        }
+

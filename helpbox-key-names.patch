+        /// <summary>
+        /// Determines whether the game is GTA IV: Complete Edition, from the file version of the
+        /// running executable: 1.2.x is Complete Edition, 1.0.x is the original release.
+        /// </summary>
+        /// <returns>True on Complete Edition. False otherwise, or if the version cannot be read.</returns>
+        private static bool IsCompleteEdition()
+        {
+            // This runs from a static initializer, where an escaping exception would make the
+            // whole class unusable, so nothing here is allowed to throw, logging included.
+            bool completeEdition = false;
+            string message;
+            try
+            {
+                System.Diagnostics.FileVersionInfo version = System.Diagnostics.Process.GetCurrentProcess().MainModule.FileVersionInfo;
+                completeEdition = version.FileMajorPart == 1 && version.FileMinorPart >= 2;
+                message = "Game version " + version.FileMajorPart + "." + version.FileMinorPart + "." + version.FileBuildPart + "." + version.FilePrivatePart
+                    + (completeEdition ? ", writing key names into help text" : ", using replacement text for key names");
+            }
+            catch (Exception exception)
+            {
+                message = "Could not read the game version, using replacement text for key names: " + exception.Message;
+            }
+
+            try
+            {
+                Engine.Log.Info(message, "TextHelper");
+            }
+            catch (Exception)
+            {
+            }
+
+            return completeEdition;
+        }
+

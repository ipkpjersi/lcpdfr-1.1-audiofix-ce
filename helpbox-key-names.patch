     /// </summary>
     internal class TextHelper
     {
+        /// <summary>
+        /// Whether key names can be written into the game's text memory through AdvancedHook.
+        /// On GTA IV: Complete Edition (1.2.x) the replacement text no longer lands, so the
+        /// borrowed replay prompts show their own keys instead, such as "," and ".". There the
+        /// key name is written into the help text directly.
+        /// </summary>
+        private static readonly bool canReplaceKeyText = !IsCompleteEdition();
+
+        /// <summary>
+        /// The unformatted text of the last help box, with its ~KEY_~ placeholders, and whether it
+        /// was built for a controller. Written key names cannot follow a change of input device the
+        /// way the game's own input tokens do, so the help box is rebuilt when the device changes.
+        /// </summary>
+        private static string lastHelpBoxText;
+        private static bool lastHelpBoxForController;
+
+        /// <summary>
+        /// Tick count since which the input device has differed from the one the help box was
+        /// built for, or 0 while it has not. Debounces a device reading that flickers.
+        /// </summary>
+        private static int inputDeviceChangedSince;
+
+        /// <summary>
+        /// Milliseconds the new input device must hold before the help box is rebuilt for it.
+        /// </summary>
+        private const int InputDeviceSettleMs = 250;
+
+        /// <summary>
+        /// Rebuilds the help box on screen when the input device has changed since it was built, so
+        /// its keys switch between keyboard names and controller buttons. Only needed where key
+        /// names are written into the text; elsewhere the game redraws its input tokens itself.
+        /// Called every tick from KeyWatchDog.Update. Never throws.
+        /// </summary>
+        public static void RefreshForInputDevice()
+        {
+            if (canReplaceKeyText || lastHelpBoxText == null)
+            {
+                return;
+            }
+
+            try
+            {
+                bool usingController = Engine.Main.KeyWatchDog.IsUsingController;
+                if (usingController == lastHelpBoxForController)
+                {
+                    inputDeviceChangedSince = 0;
+                    return;
+                }
+
+                if (!IsHelpboxBeingDisplayed)
+                {
+                    // The box has gone, so there is nothing to rebuild.
+                    lastHelpBoxText = null;
+                    inputDeviceChangedSince = 0;
+                    return;
+                }
+
+                int now = Environment.TickCount;
+                if (inputDeviceChangedSince == 0)
+                {
+                    inputDeviceChangedSince = now == 0 ? 1 : now;
+                    return;
+                }
+
+                if (now - inputDeviceChangedSince < InputDeviceSettleMs)
+                {
+                    return;
+                }
+
+                inputDeviceChangedSince = 0;
+                Engine.Log.Info("Input device changed to " + (usingController ? "controller" : "keyboard") + ", rebuilding help box", "TextHelper");
+                PrintFormattedHelpBox(lastHelpBoxText, true);
+            }
+            catch (Exception exception)
+            {
+                lastHelpBoxText = null;
+                try
+                {
+                    Engine.Log.Warning("RefreshForInputDevice failed: " + exception.Message, "TextHelper");
+                }
+                catch (Exception)
+                {
+                }
+            }
+        }
+

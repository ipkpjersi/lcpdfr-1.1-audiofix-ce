diff --git a/LCPD First Response/Engine/Scripting/Entities/PoolUpdaterUnmanaged.cs b/LCPD First Response/Engine/Scripting/Entities/PoolUpdaterUnmanaged.cs
index 4e9845d..77e9349 100644
--- a/LCPD First Response/Engine/Scripting/Entities/PoolUpdaterUnmanaged.cs	
+++ b/LCPD First Response/Engine/Scripting/Entities/PoolUpdaterUnmanaged.cs	
@@ -110,6 +110,140 @@
                     }
                 }
             }
+
+            this.ReconcileWithGame();
+        }
+
+        /// <summary>
+        /// Milliseconds between reconciliations of the pools against the game's own entity lists.
+        /// </summary>
+        private const int ReconcileIntervalMs = 2000;
+
+        /// <summary>
+        /// Tick count at which the next reconciliation is due.
+        /// </summary>
+        private int nextReconcile;
+
+        /// <summary>
+        /// Vehicles and peds the creation hooks missed this session, for the log.
+        /// </summary>
+        private int missedVehiclesTotal;
+        private int missedPedsTotal;
+        private int prunedVehiclesTotal;
+
+        /// <summary>
+        /// After startup, new peds and vehicles reach the pools only through AdvancedHook's
+        /// creation hooks. On GTA IV: Complete Edition those hooks miss some, so a ped can sit in
+        /// a vehicle the pool does not know and CurrentVehicle returns null. Every couple of
+        /// seconds this walks the game's own lists through ScriptHookDotNet, as the constructor
+        /// does once at startup, adds whatever the hooks missed, prunes vehicles the game no
+        /// longer has, since the deletion hook misses as well, and logs the counts, which also
+        /// measures how far the hooks fall short. Never throws into the engine loop.
+        /// </summary>
+        private void ReconcileWithGame()
+        {
+            int now = System.Environment.TickCount;
+            if (now - this.nextReconcile < 0)
+            {
+                return;
+            }
+
+            this.nextReconcile = now + ReconcileIntervalMs;
+
+            try
+            {
+                int addedVehicles = 0;
+                System.Collections.Generic.HashSet<int> gameVehicles = new System.Collections.Generic.HashSet<int>();
+                foreach (GTA.Vehicle vehicle in GTA.World.GetAllVehicles())
+                {
+                    if (vehicle == null || !vehicle.Exists())
+                    {
+                        continue;
+                    }
+
+                    gameVehicles.Add(vehicle.pHandle);
+                    if (Pools.VehiclePool.AtVehicleHandle(vehicle.pHandle) == null)
+                    {
+                        new CVehicle(vehicle.pHandle);
+                        addedVehicles++;
+                    }
+                }
+
+                // The deletion hook misses on Complete Edition too, so vehicles the game has
+                // removed stay in the pool: 1546 entries against about 100 real vehicles after ten
+                // minutes, and the game then crashed on LCPDFR's thread reading through a null
+                // entity pointer. Drop whatever the game no longer lists, as the deleted-handles path
+                // above does. Checked against the game's list rather than with Exists(), so no native
+                // is ever called with a stale handle. GetAll() returns a copy, so removing is safe.
+                int prunedVehicles = 0;
+                foreach (CVehicle cVehicle in Pools.VehiclePool.GetAll())
+                {
+                    if (!gameVehicles.Contains(cVehicle.Handle))
+                    {
+                        Pools.VehiclePool.Remove(cVehicle);
+                        prunedVehicles++;
+                    }
+                }
+
+                // Same filters as the constructor. Checked after the vehicles, whose creation adds
+                // their occupants, so those are not counted twice.
+                int addedPeds = 0;
+                System.Collections.Generic.HashSet<int> gamePeds = new System.Collections.Generic.HashSet<int>();
+                foreach (GTA.Ped ped in GTA.World.GetAllPeds())
+                {
+                    if (ped == null || !ped.Exists())
+                    {
+                        continue;
+                    }
+
+                    gamePeds.Add(ped.pHandle);
+                    if (ped.pHandle == GTA.Game.LocalPlayer.Character.pHandle || !ped.isAliveAndWell)
+                    {
+                        continue;
+                    }
+
+                    if (Pools.PedPool.AtPedHandle(ped.pHandle) == null)
+                    {
+                        new CPed(ped.pHandle);
+                        addedPeds++;
+                    }
+                }
+
+                // Peds are only counted, not removed: their pool has stayed at a normal size, so
+                // there is no evidence the ped deletion hook misses, and removing a ped a script
+                // still holds is riskier than a vehicle.
+                int stalePeds = 0;
+                foreach (CPed cPed in Pools.PedPool.GetAll())
+                {
+                    if (!gamePeds.Contains(cPed.Handle))
+                    {
+                        stalePeds++;
+                    }
+                }
+
+                if (addedVehicles > 0 || addedPeds > 0 || prunedVehicles > 0)
+                {
+                    this.missedVehiclesTotal += addedVehicles;
+                    this.missedPedsTotal += addedPeds;
+                    this.prunedVehiclesTotal += prunedVehicles;
+                    Log.Warning("ReconcileWithGame: creation hooks missed " + addedVehicles + " vehicle(s) and " + addedPeds
+                        + " ped(s), added now; pruned " + prunedVehicles + " vehicle(s) the game no longer has. Session total: "
+                        + this.missedVehiclesTotal + " vehicle(s) and " + this.missedPedsTotal + " ped(s) added, "
+                        + this.prunedVehiclesTotal + " vehicle(s) pruned. Pools hold " + Pools.VehiclePool.Count + " vehicles (game "
+                        + gameVehicles.Count + "), " + Pools.PedPool.Count + " peds (game " + gamePeds.Count + ", " + stalePeds
+                        + " not in game).", "PoolUpdater");
+                }
+            }
+            catch (System.Exception exception)
+            {
+                try
+                {
+                    Log.Warning("ReconcileWithGame: failed, will retry: " + exception.Message, "PoolUpdater");
+                }
+                catch (System.Exception)
+                {
+                }
+            }
         }
 
         private void Hook()
